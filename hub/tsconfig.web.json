{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client"],
    // frontend/src/cesium.ts imports Cesium's types; when Cloudflare builds only hub/ is installed
    "paths": { "cesium": ["./node_modules/cesium"] }
  },
  "include": ["web/src"]
}
